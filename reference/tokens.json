{
  "_about": "NiStudioUs redesign design tokens, copied 1:1 from src/style.css + src/accents.json + src/fonts.css (2026-10-05). Units: px unless noted; rem = 16px. clamp(min, preferred, max) = CSS clamp, vw = 1% of viewport width.",
  "colors": {
    "dark": {
      "bg": "#0b0b10", "bgAlt": "#0f0f16", "surface": "#14141c", "surface2": "#1b1b26",
      "border": "#25252f", "text": "#ececf4", "muted": "#9b9bb3",
      "accent": "#b4b0ff", "accent2": "#7c6cff", "accentInk": "#14112e",
      "glow": "rgba(124,108,255,0.22)",
      "shadow": "0 20px 50px -20px rgba(0,0,0,0.70)",
      "topbarBg": "bg at 78% opacity + backdrop blur 14px saturate 1.4",
      "btnPrimaryText": "accentInk",
      "badge": { "bg": "rgba(255,176,32,0.15)", "fg": "#f5a623" },
      "meshOpacity": [0.55, 0.30, 0.25]
    },
    "light": {
      "bg": "#f8f7fc", "bgAlt": "#f0eef9", "surface": "#ffffff", "surface2": "#f3f1fb",
      "border": "#e3e0f0", "text": "#17152b", "muted": "#62607a",
      "accent": "#5b4bdb", "accent2": "#7c6cff", "accentInk": "#ffffff",
      "glow": "rgba(91,75,219,0.14)",
      "shadow": "0 20px 40px -22px rgba(60,40,140,0.35)",
      "btnPrimaryText": "#ffffff",
      "badge": { "bg": "rgba(245,166,35,0.18)", "fg": "#8a5300" },
      "meshOpacity": [0.25, 0.25, 0.25]
    },
    "fixed": {
      "gradTextEnd": "#e6a8ff", "meshPink": "#e46bff", "meshBlue": "#3ea8ff",
      "liveDot": "#4ade80", "lightboxScrim": "rgba(5,5,10,0.88)", "codeFont": "ui-monospace, 'Cascadia Code', Consolas, monospace"
    },
    "perAppAccent": {
      "_rule": "Inside any element of an app (its pages, its home card, its feature row, the hero spotlight) accent/accent2 are replaced; glow = accent2 at 0.24 (dark) / 0.16 (light); accentInk = #0b0b10 (dark) / #ffffff (light).",
      "scribble-notes": { "dark": { "accent": "#5fd3dc", "accent2": "#2aa3b5" }, "light": { "accent": "#1b6471", "accent2": "#2aa3b5" } },
      "sms-stack":      { "dark": { "accent": "#7ab8ff", "accent2": "#3b8cf0" }, "light": { "accent": "#1560bd", "accent2": "#3b8cf0" } },
      "iky":            { "dark": { "accent": "#b9a6ff", "accent2": "#7a5cf0" }, "light": { "accent": "#4b2fb5", "accent2": "#7a5cf0" } }
    }
  },
  "gradients": {
    "gradText": "linear-gradient(100deg, accent 0%, accent2 60%, #e6a8ff 100%) clipped to text",
    "btnPrimary": "linear-gradient(135deg, accent, accent2) + shadow 0 10px 28px -10px accent2",
    "progressBar": "linear-gradient(90deg, accent2, accent), height 3px, fixed top, width = scroll %",
    "contactCard": "radial-gradient(600px 220px at 50% 0, glow, transparent) over surface",
    "callout": "linear-gradient(90deg, glow, transparent) over surface; border accent 40% mixed with border",
    "tocActive": "linear-gradient(90deg, glow, transparent)",
    "learnImgPlaceholder": "linear-gradient(135deg, surface2, bgAlt)",
    "appHeroGlow": "radial-gradient(closest-side, glow, transparent) 700x600 at top-right (-200px top, -100px right)",
    "timelineLine": "linear-gradient(accent, border) 2px wide"
  },
  "typography": {
    "fonts": {
      "body": "Inter (variable, weights 400/500/600), fallback system-ui, -apple-system, Segoe UI, sans-serif",
      "display": "Space Grotesk (variable, weights 500/600/700), fallback = body",
      "files": ["assets/fonts/inter-400.woff2 (variable)", "assets/fonts/space-grotesk-500.woff2 (variable)"],
      "smoothing": "antialiased"
    },
    "base": { "size": 16, "lineHeight": 1.65, "weight": 400, "font": "body" },
    "headings": { "font": "display", "lineHeight": 1.12, "letterSpacing": "-0.02em" },
    "scale": {
      "heroH1":   { "size": "clamp(3.2rem, 9.2vw, 8rem)", "weight": 700, "lineHeight": 0.95, "letterSpacing": "-0.045em" },
      "h1":       { "size": "clamp(2.4rem, 5.4vw, 4.3rem)", "weight": 700 },
      "appH1":    { "size": "clamp(2rem, 4vw, 3.2rem)", "weight": 700, "margin": "20px 0 6px" },
      "legalH1":  { "size": "clamp(2rem, 4vw, 3rem)", "weight": 700 },
      "pageTitle":{ "size": "clamp(2rem, 4vw, 3.2rem)", "margin": "18px 0 8px" },
      "notFoundTitle": { "size": "clamp(2.4rem, 6vw, 4rem)" },
      "h2":       { "size": "clamp(1.7rem, 3vw, 2.4rem)", "weight": 600 },
      "h3":       { "size": "1.25rem", "weight": 600 },
      "hSm":      { "size": "1.3rem", "marginBottom": 18 },
      "lead":     { "size": "clamp(1.05rem, 1.6vw, 1.22rem)", "color": "muted", "maxWidth": "58ch", "marginTop": 22 },
      "heroLead": { "size": "clamp(1.1rem, 1.7vw, 1.35rem)", "maxWidth": "52ch", "marginTop": 30 },
      "eyebrow":  { "size": ".74rem", "weight": 600, "font": "display", "letterSpacing": ".14em", "upper": true, "color": "accent", "lineHeight": 1, "marginBottom": 14 },
      "statNum":  { "size": "clamp(2.2rem, 4.5vw, 3.6rem)", "weight": 700, "font": "display", "letterSpacing": "-0.03em" },
      "statLabel":{ "size": ".86rem", "color": "muted" },
      "brand":    { "size": "1.02rem", "weight": 600, "font": "display" },
      "nav":      { "size": ".94rem", "color": "muted" },
      "button":   { "size": ".95rem", "weight": 600, "font": "body" },
      "buttonLg": { "size": "1.02rem" },
      "tag":      { "size": ".78rem", "color": "muted" },
      "chip":     { "size": ".88rem", "color": "text" },
      "badge":    { "size": ".7rem", "weight": 600, "font": "display", "letterSpacing": ".1em" },
      "appSub":   { "size": "1.12rem", "weight": 500, "font": "display" },
      "marquee":  { "size": "1.05rem", "weight": 600, "font": "display", "color": "muted" },
      "crumbs":   { "size": ".86rem", "color": "muted" },
      "tocLabel": { "size": ".72rem", "weight": 600, "font": "display", "letterSpacing": ".12em", "upper": true },
      "tocLink":  { "size": ".9rem" },
      "docBody":  { "color": "text mixed 82% with muted", "maxWidth": "74ch" },
      "subH3":    { "size": "1.12rem", "marginBottom": 8 },
      "footerHead": { "size": ".86rem", "weight": 600, "font": "display" },
      "footerLink": { "size": ".9rem", "color": "muted" },
      "footBase": { "size": ".85rem", "color": "muted" },
      "code":     { "size": ".86em", "font": "mono", "bg": "surface2", "border": "1px border", "padding": "1px 6px", "radius": 6 }
    }
  },
  "radius": { "r": 18, "card": 28, "pill": 999, "menu": 14, "phone": 28, "phoneScreen": 22, "shot": 22, "galleryShot": 18, "inlineImg": 16, "icon": "20%", "iconSmall": "22%", "brandImg": 9, "stage": 24, "stageIcon": 28, "spot": 20, "tlSteps": 14, "skip": 8, "focus": 6 },
  "spacing": {
    "wrap": "width: min(1160px, 100% - 32px), centered",
    "topbarHeight": 64, "scrollPaddingTop": 84,
    "section": "padding clamp(56px, 8vw, 104px) 0", "sectionTight": "28px 0 56px",
    "secHeadMaxWidth": 720, "secHeadMarginBottom": 44,
    "hero": "padding clamp(56px, 8vw, 100px) 0 0",
    "ctaGap": 10, "ctaMarginTop": 26,
    "button": "12px 20px", "buttonLg": "16px 28px", "pill": "7px 16px 7px 12px",
    "card": "clamp(22px, 3vw, 40px)", "featRow": "20px 24px", "featCard": 20,
    "gridGaps": { "heroGrid": 24, "appHeroGrid": 48, "appCard": 32, "appList": 28, "learnGrid": 20, "featGrid": 14, "featRows": 14, "docLayout": 56, "footGrid": 32 }
  },
  "elevation": { "shadow": "token colors.<theme>.shadow", "cardHover": "0 30px 70px -40px accent2", "featCardHover": "0 18px 40px -26px accent2", "stageIcon": "0 24px 60px -18px accent2 + 0 0 0 8px accent@12%" },
  "motion": {
    "reveal": "opacity 0 → 1 and translateY(22px) → 0, .7s ease, triggered once when 8% of the element is visible",
    "float": "hero phones: translateY 0 → -12px → 0, 7s ease-in-out infinite; phone 2 delay -2s, phone 3 delay -4s",
    "drift": "mesh blobs: translate(60px, 40px) scale(1.12), 14s ease-in-out infinite alternate; delays 0 / -5s / -9s; blur 90px",
    "marquee": "row of all feature titles twice, translateX 0 → -50%, 60s linear infinite; pauses on hover; edges fade 8%",
    "ping": "live dot: box-shadow 0 → 10px ring fading out, 2s infinite",
    "hoverLift": { "button": "-2px .15s", "spot": "-3px .2s", "featCard": "-4px .2s", "learnCard": "-5px .2s", "chip": "-2px .15s", "galleryImg": "scale 1.03 .2s", "learnImg": "scale 1.05 .5s" },
    "themeSwitch": "background + color .25s",
    "reducedMotion": "all animations and transitions off; reveal shows immediately"
  },
  "breakpoints": { "mobile": "max-width 900px (one column, burger menu, horizontal TOC, 2-col footer, 2-col stats, phones 170px)" },
  "layout": {
    "heroGrid": "1.35fr .65fr (home); 1.1fr .9fr (app pages)",
    "phones": { "home": { "width": 230, "p1": "left 0, top 90, rotate -6deg", "p2": "left 26%, top 10, rotate 3deg, z 2", "p3": "right 0, top 150, rotate 9deg", "artHeight": 600 },
                "app": { "width": 210, "p1": "left 8%, top 40, rotate -6deg", "p2": "left 42%, top 40, rotate 3deg", "artHeight": 420 },
                "frame": "aspect 9/19, padding 7, surface2 bg, 1px border, radius 28, screen radius 22, image cover top" },
    "appCard": "2 columns (copy | shots), alternate cards flip; shots = 3 columns, 2nd offset +34px, 3rd +10px, max-height 440 with bottom fade",
    "docLayout": "250px sticky TOC (top 88) | content",
    "footGrid": "1.4fr + 3 × 1fr"
  }
}
