{
  "name": "chapter-1",
  "version": "1.0.0",
  "description": "Playwright Automation Tests for the learning app.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "show-report": "playwright show-report reports/html",
    "show-allure-report": "allure serve ./reports/allure-results",
    "docker:build": "docker build -t playwright-e2e .",
    "docker:run": "docker run --rm -v $(pwd)/playwright-report:/playwright-e2e/playwright-report -v $(pwd)/test-results:/playwright-e2e/test-results -v $(pwd)/reports:/playwright-e2e/reports -e BASE_URL=${BASE_URL:-https://nistudious.github.io/home/learning/apps/chapter-1} playwright-e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "allure-commandline": "^2.42.1",
    "allure-playwright": "^3.9.0",
    "typescript": "^6.0.3"
  }
}
